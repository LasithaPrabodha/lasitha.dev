---
import MyName from "@components/MyName.astro";

import RectPattern from "@components/RectPattern.astro";
---

<section id="about" class="mb-52 fade-in-section">
  <div class="center">
    <div class="name mt-12 sm:mt-0">
      <small class="uppercase">About</small>
      <h2 class="relative">
        <MyName showSinhala={true} />
      </h2>
    </div>
  </div>
  <div class="flex max-sm:block mt-12 gap-2">
    <div class="flex-1 sm:pr-2">
       <p class="sm:text-justify">
        Hi there! I'm Lasitha Prabodha Weligampola, and I'm excited to introduce myself.
       </p>
      <p class="sm:text-justify">
         My journey with technology began in 2002 as a child, and today I'm a Senior Software Engineer with over eight years of experience building web and mobile applications that are both functional and enjoyable to use. ⚡
      </p>
      <p class="sm:text-justify">
          I specialize in Angular, React, TypeScript, C#, .NET Core, Azure, and other modern web technologies. I've worked with startups, mid-sized companies, and large enterprises - leading the development of innovative applications and modernizing legacy systems.
      </p>
    </div>
    <div class="details-photo h-min relative max-w-full sm:max-w-64">
      <img class="me" id="me-photo" src="/static/casual-photo-192x192.png" width="192" height="192" alt="Lasitha Prabodha Weligampola" />
      <canvas class="me me-pixel" id="me-pixel" width="192" height="192" aria-hidden="true"></canvas>
      <RectPattern width={256} height={256} />
    </div>
  </div>
  <p class="sm:text-justify">
      I'm passionate about continuous learning and growth, whether it's mastering emerging technologies or improving user experiences. I thrive in collaborative environments and value strong, supportive teams - but I'm equally effective when working independently. 🚀
  </p>
  <p class="sm:text-justify">
      Outside of coding, music fuels my creativity. From the godfathers of heavy metal to the most intense modern metal, I love exploring every dark, thunderous corner of the metal universe 🤘🏼 - but I have a soft spot for other genres too. 
      I also find inspiration in nature, exploring beautiful landscapes that combine serenity with grandeur, helping me recharge and stay inspired.
  </p>
  <p class="sm:text-justify">
    I'm always excited to push the boundaries of technology and make a meaningful impact. Let's connect - whether it's to talk tech, music, or potential collaborations. 🤝
  </p>
  <div class="flex justify-center mt-12">
    <iframe
      id="now-playing-frame"
      data-src="https://whats-lasitha-now-playing.vercel.app/player"
      width="430"
      height="88"
      style="border: none; max-width: 100%;"
      title="Now Playing"
      loading="lazy"
    ></iframe>
  </div>
</section>

<style>
  .fade-in-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 1s ease, transform 1s ease;
  }

  .fade-in-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.details-photo > svg) {
    position: absolute;
    left: 20px;
    top: -10px;
    z-index: -1;
    transition: var(--transition);
  }
  .details-photo {
    width: 16rem;
    flex-shrink: 0;
    transition: var(--transition);
    margin-bottom: 1em;
  }

  .details-photo:hover {
    transform: translate(3px, -3px);
  }

  .details-photo:hover img {
    transition: var(--transition);
  }

  :global(.details-photo:hover > svg) {
    transform: translate(6px, -6px);
  }

  .me {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    image-rendering: pixelated;
    border-radius: 16px;
    box-shadow: var(--shadow);
    position: relative;
    background-image: url("/src/assets/images/blur.png");
    background-size: contain;
  }

  .me-pixel {
    display: none;
  }
  .pixel-ready #me-photo {
    display: none;
  }
  .pixel-ready .me-pixel {
    display: block;
  }

  :global([data-theme="dark"]) .me {
    opacity: 0.75;
  }

  :global([data-theme="dark"]) .details-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--clr-bg);
    z-index: 0;
    border-radius: 16px;
  }

  :global([data-theme="dark"]) .me {
    z-index: 1;
  }
  h2::before {
    content: "";
    display: block;
    position: absolute;
    width: 90px;
    height: 1px;
    left: -120px;
    margin: 0px auto;
    background-color: var(--clr-quote);
    top: 50%;
  }
  h2::after {
    content: "";
    display: block;
    position: absolute;
    width: 90px;
    height: 1px;
    right: -120px;
    margin: 0px auto;
    background-color: var(--clr-quote);
    top: 50%;
  }

  @media (max-width: 640px) {
    .details {
      display: block;
    }

    img {
      margin-top: 0;
      margin-bottom: 1rem;
      width: 100%;
      height: 100%;
    }

    .details-photo:hover {
      transform: translate(0px, -5px);
    }
  }
</style>

<script>
  const section = document.getElementById("about");
  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("visible");
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  }

  // Pixelate effect: resolves from coarse blocks to a fine, permanent pixel-art
  // look (indie-game style) when scrolled into view.
  const photo = document.getElementById("me-photo") as HTMLImageElement | null;
  const canvas = document.getElementById("me-pixel") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");
  if (photo && canvas && ctx) {
    const SIZE = canvas.width;
    const STEPS = [16, 12, 8, 6, 4, 3, 2, 1.5];
    const MAX = STEPS.length - 1;
    const small = document.createElement("canvas");
    const sctx = small.getContext("2d")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let level = 0;
    let target = 0;
    let timer: number | undefined;

    const draw = (block: number) => {
      const n = Math.max(1, Math.ceil(SIZE / block));
      small.width = small.height = n;
      sctx.imageSmoothingEnabled = true;
      sctx.drawImage(photo, 0, 0, n, n);
      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, SIZE, SIZE);
      ctx.drawImage(small, 0, 0, n, n, 0, 0, n * block, n * block);
    };

    const step = () => {
      if (level === target) { timer = undefined; return; }
      level += level < target ? 1 : -1;
      draw(STEPS[level]);
      timer = window.setTimeout(step, 70);
    };
    const goTo = (t: number) => {
      target = t;
      if (reduced) { level = t; draw(STEPS[level]); return; }
      if (timer === undefined) step();
    };

    const init = () => {
      draw(STEPS[0]);
      const wrap = photo.parentElement!;
      wrap.classList.add("pixel-ready");
      new IntersectionObserver(([e], o) => {
        if (e.isIntersecting) { goTo(MAX); o.disconnect(); }
      }, { threshold: 0.3 }).observe(wrap);
    };
    if (photo.complete) init(); else photo.addEventListener("load", init, { once: true });
  }

  const nowPlayingFrame = document.getElementById("now-playing-frame") as HTMLIFrameElement | null;
  if (nowPlayingFrame) {
    const PLAYER_ORIGIN = "https://whats-lasitha-now-playing.vercel.app";
    const baseSrc = nowPlayingFrame.dataset.src!;

    const currentTheme = () => (document.body.getAttribute("data-theme") === "dark" ? "dark" : "light");

    nowPlayingFrame.src = `${baseSrc}?theme=${currentTheme()}`;

    new MutationObserver(() => {
      nowPlayingFrame.contentWindow?.postMessage({ theme: currentTheme() }, PLAYER_ORIGIN);
    }).observe(document.body, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
