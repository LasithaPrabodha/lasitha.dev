---
import { CanvasText } from "@/components/ui/canvas-text";
import { EncryptedText } from "@/components/ui/encrypted-text";
---

<section class="min-h-screen center flex-col animate-fade-up animate-ease-out">
  <h1 class="text-5xl max-sm:text-4xl">
    Hi, I am{" "}
    <CanvasText
      client:visible
      text="Lasitha Prabodha"
      className="font-bold"
      backgroundClassName="bg-[#6344F5]"
      colors={[
        "rgba(174, 72, 255, 1)",
        "rgba(174, 72, 255, 0.9)",
        "rgba(174, 72, 255, 0.8)",
        "rgba(174, 72, 255, 0.7)",
        "rgba(174, 72, 255, 0.6)",
        "rgba(174, 72, 255, 0.5)",
        "rgba(174, 72, 255, 0.4)",
        "rgba(174, 72, 255, 0.3)",
        "rgba(174, 72, 255, 0.2)",
        "rgba(174, 72, 255, 0.1)",
      ]}
      lineGap={4}
      animationDuration={20}
    />
  </h1>
  <h2 class="text-[2.4rem] leading-[0.8] max-sm:text-3xl max-sm:mt-4 text-[color:var(--clr-quote)]">
    I build things for <span class="glow-text">web and mobile</span>
  </h2>
  <p class="mt-6">
    <EncryptedText
      client:visible
      text="A software engineer specializing in building exceptional digital experiences"
      encryptedClassName="text-[color:var(--clr-quote)]"
      revealDelayMs={15}
      flipDelayMs={25}
    />
  </p>

  <a href="/blog" class="button-container z-0 my-0 mt-4 mx-auto w-[200px]">
    <span class="mas">Check out my blog!</span>
    <button type="button" name="Hover">Check out my blog!</button>
  </a>
</section>

<style>
  .glow-text {
    color: var(--clr-fg-alt);
    text-shadow: 0 0 6px rgba(170, 110, 255, 0.35);
  }

  :global([data-theme="light"]) .glow-text {
    color: var(--clr-fg-alt);
    text-shadow: none;
  }
</style>
